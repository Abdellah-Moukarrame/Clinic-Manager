<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                https://jakarta.ee/xml/ns/persistence
                https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="clinic-manager" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.clinic_manager.model.User</class>
        <class>com.example.clinic_manager.model.Staff</class>
        <class>com.example.clinic_manager.model.Doctor</class>
        <class>com.example.clinic_manager.model.Admin</class>
        <class>com.example.clinic_manager.model.Patient</class>
        <class>com.example.clinic_manager.model.Department</class>
        <class>com.example.clinic_manager.model.Appointment</class>
        <class>com.example.clinic_manager.model.Availability</class>
        <class>com.example.clinic_manager.model.MedicalNote</class>
        <class>com.example.clinic_manager.model.Specialty</class>


        <properties>

            <!-- PostgreSQL connection -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5433/clinic_manager"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="postgres"/>

            <!-- Hibernate -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>